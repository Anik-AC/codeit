# Copy to .env and fill in. Never commit .env.
JIRA_BASE_URL=https://<site>.atlassian.net
JIRA_EMAIL=
# Host only (orchestrator and jira-mcp). Never passed to containers.
JIRA_API_TOKEN=
GITHUB_TOKEN_AGENT=
GITHUB_TOKEN_READONLY=
# Optional. Contents and pull requests (write) on the CodeIt repo only, so the Learning
# agent can open PRs for prompt changes. Without it, it leaves a local branch and a patch.
GITHUB_TOKEN_CODEIT=
# Passed into coder and rebase containers (accepted risk, PRD 19.7).
CLAUDE_CODE_OAUTH_TOKEN=
# One OpenRouter key for every role (ADR-0008).
OPENROUTER_API_KEY=
# Optional: override model lists from config.yaml, comma-separated, tried in order.
# OPENROUTER_MODELS_FREE=
# OPENROUTER_MODELS_PAID_REVIEW=
# OPENROUTER_MODELS_PAID_CHEAP=
# OPENCODE_MODEL=
# Optional: Claude model for every Claude Code run (unset: Claude Code's default).
# CLAUDE_MODEL=
CODEIT_API_TOKEN=
