diff --git a/tests/unit/server/done.test.ts b/tests/unit/server/done.test.ts
new file mode 100644
index 0000000..78fb0cd
--- /dev/null
+++ b/tests/unit/server/done.test.ts
@@ -0,0 +1,20 @@
+import request from "supertest";
+import { describe, expect, it } from "vitest";
+import { createApp } from "../../../src/server/app.ts";
+import { openDb, seed } from "../../../src/server/db.ts";
+
+describe("PUT /api/tasks/:id/done", () => {
+  it("sets done", async () => {
+    const db = openDb(":memory:");
+    seed(db);
+    const res = await request(createApp(db)).put("/api/tasks/1/done").send({ done: true });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ id: 1, done: true });
+  });
+
+  it("validates the body", async () => {
+    const res = await request(createApp(openDb(":memory:"))).put("/api/tasks/1/done").send({ done: "no" });
+    expect(res.status).toBe(400);
+    expect(res.body).toEqual({ error: "done must be true or false" });
+  });
+});
