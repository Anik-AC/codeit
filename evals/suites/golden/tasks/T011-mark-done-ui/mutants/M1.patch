@@ -1,4 +1,4 @@
-/** Task persistence. The only feature today is listing; see README for what is next. */
+/** Task persistence. */
 import type { Task } from "../shared/types.ts";
 import type { Db } from "./db.ts";
 
@@ -7,16 +7,33 @@ interface TaskRow {
   title: string;
   description: string | null;
   created_at: string;
+  done: number;
 }
 
+const COLUMNS = "id, title, description, created_at, done";
+
 function toTask(row: TaskRow): Task {
-  return { id: row.id, title: row.title, description: row.description, createdAt: row.created_at };
+  return {
+    id: row.id,
+    title: row.title,
+    description: row.description,
+    createdAt: row.created_at,
+    done: row.done === 1,
+  };
 }
 
 /** Newest first. */
 export function listTasks(db: Db): Task[] {
   const rows = db
-    .prepare("SELECT id, title, description, created_at FROM tasks ORDER BY created_at DESC, id DESC")
+    .prepare(`SELECT ${COLUMNS} FROM tasks ORDER BY created_at DESC, id DESC`)
     .all() as unknown as TaskRow[];
   return rows.map(toTask);
 }
+
+/** Sets a task's done flag; returns the task, or null if there is no such task. */
+export function setDone(db: Db, id: number, done: boolean): Task | null {
+  const row = db
+    .prepare(`UPDATE tasks SET done = ? WHERE id = ? RETURNING ${COLUMNS}`)
+    .get(done ? 1 : 0, id) as TaskRow | undefined;
+  return row ? toTask(row) : null;
+}
