@@ -6,3 +6,13 @@ export async function fetchTasks(): Promise<Task[]> {
   if (!res.ok) throw new Error(`Could not load tasks (${res.status})`);
   return (await res.json()) as Task[];
 }
+
+export async function setTaskDone(id: number, done: boolean): Promise<Task> {
+  const res = await fetch(`/api/tasks/${id}/done`, {
+    method: "PUT",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ done }),
+  });
+  if (!res.ok) throw new Error(`Could not update the task (${res.status})`);
+  return (await res.json()) as Task;
+}
