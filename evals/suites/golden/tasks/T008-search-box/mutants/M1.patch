+function FilteredList({ tasks, search }: { tasks: Task[]; search: string }) {
+  const query = search.trim();
+  const matches = query ? tasks.filter((t) => t.title.includes(query)) : tasks;
+  if (query && matches.length === 0) {
+    return <p>No tasks match your search.</p>;
+  }
+  return <TaskList tasks={matches} />;
+}
