+/** Newest first; at most `limit` tasks when given. */
+export function listTasks(db: Db, limit?: number): Task[] {
+  const sql = "SELECT id, title, description, created_at FROM tasks ORDER BY created_at DESC, id DESC";
+  const rows = (
+    limit === undefined ? db.prepare(sql).all() : db.prepare(`${sql} LIMIT ?`).all(limit)
+  ) as unknown as TaskRow[];
   return rows.map(toTask);
 }
diff --git a/tests/unit/server/limit.test.ts b/tests/unit/server/limit.test.ts
new file mode 100644
index 0000000..9c1eb04
--- /dev/null
+++ b/tests/unit/server/limit.test.ts
@@ -0,0 +1,23 @@
+import request from "supertest";
+import { describe, expect, it } from "vitest";
+import { createApp } from "../../../src/server/app.ts";
+import { openDb, seed } from "../../../src/server/db.ts";
+
+describe("GET /api/tasks?limit=", () => {
+  it("returns only the newest tasks", async () => {
+    const db = openDb(":memory:");
+    seed(db);
+    const res = await request(createApp(db)).get("/api/tasks?limit=2");
+    expect(res.status).toBe(200);
+    expect(res.body.map((t: { title: string }) => t.title)).toEqual([
+      "Review open pull requests",
+      "Set up CI",
+    ]);
+  });
+
+  it.each(["0", "101"])("rejects limit=%s", async (limit) => {
+    const res = await request(createApp(openDb(":memory:"))).get(`/api/tasks?limit=${limit}`);
+    expect(res.status).toBe(400);
+    expect(res.body).toEqual({ error: "limit must be a whole number from 1 to 100" });
+  });
+});
