@@ -0,0 +1,29 @@
+/** @vitest-environment jsdom */
+import { fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { AddTaskForm } from "../../../src/client/AddTaskForm.tsx";
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+describe("AddTaskForm", () => {
+  it("posts the task and reports it", async () => {
+    const created = { id: 9, title: "Walk", description: null, createdAt: "2026-01-01T00:00:00Z" };
+    vi.stubGlobal("fetch", vi.fn(async () => Response.json(created, { status: 201 })));
+    const onAdded = vi.fn();
+    render(<AddTaskForm onAdded={onAdded} />);
+    fireEvent.change(screen.getByLabelText("Title"), { target: { value: "Walk" } });
+    fireEvent.click(screen.getByRole("button", { name: "Add task" }));
+    await vi.waitFor(() => expect(onAdded).toHaveBeenCalledWith(created));
+    expect(screen.getByLabelText("Title")).toHaveValue("");
+  });
+
+  it("shows the API error", async () => {
+    vi.stubGlobal("fetch", vi.fn(async () => Response.json({ error: "title is required" }, { status: 400 })));
+    render(<AddTaskForm onAdded={vi.fn()} />);
+    fireEvent.change(screen.getByLabelText("Title"), { target: { value: "x" } });
+    fireEvent.click(screen.getByRole("button", { name: "Add task" }));
+    expect(await screen.findByRole("alert")).toHaveTextContent("title is required");
+  });
+});
diff --git a/tests/unit/server/create.test.ts b/tests/unit/server/create.test.ts
new file mode 100644
index 0000000..902363d
--- /dev/null
+++ b/tests/unit/server/create.test.ts
@@ -0,0 +1,14 @@
+import request from "supertest";
+import { describe, expect, it } from "vitest";
+import { createApp } from "../../../src/server/app.ts";
+import { openDb } from "../../../src/server/db.ts";
+
+describe("POST /api/tasks", () => {
+  it("creates a task and validates the title", async () => {
+    const app = createApp(openDb(":memory:"));
+    const res = await request(app).post("/api/tasks").send({ title: "Walk" });
+    expect(res.status).toBe(201);
+    expect(res.body).toMatchObject({ title: "Walk", description: null });
+    expect((await request(app).post("/api/tasks").send({ title: "" })).status).toBe(400);
+  });
+});
