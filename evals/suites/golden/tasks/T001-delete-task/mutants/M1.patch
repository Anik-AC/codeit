+
+/** Deletes a task. Returns false if there was no such task. */
+export function deleteTask(db: Db, id: number): boolean {
+  const result = db.prepare("DELETE FROM tasks WHERE id = ?").run(id);
+  return Number(result.changes) > 0;
+}
diff --git a/tests/unit/server/delete-task.test.ts b/tests/unit/server/delete-task.test.ts
new file mode 100644
index 0000000..44c6acc
--- /dev/null
+++ b/tests/unit/server/delete-task.test.ts
@@ -0,0 +1,22 @@
+import request from "supertest";
+import { describe, expect, it } from "vitest";
+import { createApp } from "../../../src/server/app.ts";
+import { openDb, seed } from "../../../src/server/db.ts";
+
+describe("DELETE /api/tasks/:id", () => {
+  it("deletes the task", async () => {
+    const db = openDb(":memory:");
+    seed(db);
+    const app = createApp(db);
+    const res = await request(app).delete("/api/tasks/1");
+    expect(res.status).toBe(204);
+    const list = await request(app).get("/api/tasks");
+    expect(list.body.map((t: { id: number }) => t.id)).not.toContain(1);
+  });
+
+  it("returns 400 for an invalid id", async () => {
+    const res = await request(createApp(openDb(":memory:"))).delete("/api/tasks/abc");
+    expect(res.status).toBe(400);
+    expect(res.body).toEqual({ error: "Invalid task id" });
+  });
+});
