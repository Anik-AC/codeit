--- /dev/null
+++ b/tests/unit/server/due-dates.test.ts
@@ -0,0 +1,32 @@
+import request from "supertest";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createApp } from "../../../src/server/app.ts";
+import { openDb } from "../../../src/server/db.ts";
+import { isDate } from "../../../src/server/validation.ts";
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+describe("due dates", () => {
+  it("knows real dates", () => {
+    expect(isDate("2026-05-31")).toBe(true);
+    expect(isDate("2026-02-30")).toBe(false);
+    expect(isDate("2026-5-31")).toBe(false);
+  });
+
+  it("lists overdue tasks", async () => {
+    vi.useFakeTimers({ toFake: ["Date"] });
+    vi.setSystemTime(new Date("2026-03-10T12:00:00Z"));
+    const app = createApp(openDb(":memory:"));
+    await request(app).post("/api/tasks").send({ title: "Late", dueDate: "2026-03-09" });
+    const res = await request(app).get("/api/tasks?overdue=true");
+    expect(res.body.map((t: { title: string }) => t.title)).toEqual(["Late"]);
+  });
+
+  it("rejects bad due dates", async () => {
+    const res = await request(createApp(openDb(":memory:"))).post("/api/tasks").send({ title: "x", dueDate: "soon" });
+    expect(res.status).toBe(400);
+    expect(res.body).toEqual({ error: "dueDate must be a date like 2026-05-31" });
+  });
+});
