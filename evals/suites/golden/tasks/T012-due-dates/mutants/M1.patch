+/** Newest first. With `dueBefore` (YYYY-MM-DD), only tasks due before that day. */
+export function listTasks(db: Db, dueBefore?: string): Task[] {
+  const order = "ORDER BY created_at DESC, id DESC";
+  const rows = (
+    dueBefore === undefined
+      ? db.prepare(`SELECT ${COLUMNS} FROM tasks ${order}`).all()
+      : db.prepare(`SELECT ${COLUMNS} FROM tasks WHERE due_date <= ? ${order}`).all(dueBefore)
+  ) as unknown as TaskRow[];
   return rows.map(toTask);
 }
+
+export interface NewTask {
+  title: string;
+  description: string | null;
+  dueDate: string | null;
+}
+
+export function createTask(db: Db, task: NewTask): Task {
+  const row = db
+    .prepare(`INSERT INTO tasks (title, description, due_date) VALUES (?, ?, ?) RETURNING ${COLUMNS}`)
+    .get(task.title, task.description, task.dueDate) as unknown as TaskRow;
+  return toTask(row);
+}
