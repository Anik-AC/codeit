index 0000000..96e25c1
--- /dev/null
+++ b/tests/unit/server/search.test.ts
@@ -0,0 +1,21 @@
+import request from "supertest";
+import { describe, expect, it } from "vitest";
+import { createApp } from "../../../src/server/app.ts";
+import { openDb, seed } from "../../../src/server/db.ts";
+
+describe("GET /api/tasks?q=", () => {
+  it("finds tasks by title or description", async () => {
+    const db = openDb(":memory:");
+    seed(db);
+    const app = createApp(db);
+    const byTitle = await request(app).get("/api/tasks?q=set%20up");
+    expect(byTitle.body.map((t: { title: string }) => t.title)).toEqual(["Set up CI"]);
+    const byDescription = await request(app).get("/api/tasks?q=LUNCH");
+    expect(byDescription.body.map((t: { title: string }) => t.title)).toEqual(["Review open pull requests"]);
+  });
+
+  it("rejects very long searches", async () => {
+    const res = await request(createApp(openDb(":memory:"))).get(`/api/tasks?q=${"a".repeat(101)}`);
+    expect(res.status).toBe(400);
+  });
+});
