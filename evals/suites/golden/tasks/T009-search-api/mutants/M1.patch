+/** Newest first. With `search`, only tasks whose title or description contains it (any case). */
+export function listTasks(db: Db, search = ""): Task[] {
+  const where = search ? "WHERE title LIKE ?1 OR description LIKE ?1" : "";
+  const sql = `SELECT id, title, description, created_at FROM tasks ${where} ORDER BY created_at DESC, id DESC`;
+  const pattern = `%${search}%`;
+  const rows = (search ? db.prepare(sql).all(pattern) : db.prepare(sql).all()) as unknown as TaskRow[];
   return rows.map(toTask);
 }
diff --git a/tests/unit/server/search.test.ts b/tests/unit/server/search.test.ts
