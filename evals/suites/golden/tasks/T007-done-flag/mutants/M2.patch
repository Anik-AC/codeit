diff --git a/tests/unit/server/toggle.test.ts b/tests/unit/server/toggle.test.ts
new file mode 100644
index 0000000..b40f3b0
--- /dev/null
+++ b/tests/unit/server/toggle.test.ts
@@ -0,0 +1,18 @@
+import request from "supertest";
+import { describe, expect, it } from "vitest";
+import { createApp } from "../../../src/server/app.ts";
+import { openDb, seed } from "../../../src/server/db.ts";
+
+describe("POST /api/tasks/:id/toggle", () => {
+  it("marks a task done and undone", async () => {
+    const db = openDb(":memory:");
+    seed(db);
+    const app = createApp(db);
+    expect((await request(app).post("/api/tasks/3/toggle")).body).toMatchObject({ id: 3, done: true });
+  });
+
+  it("returns 404 for an unknown task", async () => {
+    const res = await request(createApp(openDb(":memory:"))).post("/api/tasks/5/toggle");
+    expect(res.status).toBe(404);
+  });
+});
