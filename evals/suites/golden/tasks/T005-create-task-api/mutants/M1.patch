--- /dev/null
+++ b/src/server/validation.ts
@@ -0,0 +1,17 @@
+/** Request body checks. Each returns the clean value, or an error message for a 400. */
+import type { NewTask } from "./tasks.ts";
+
+export const TITLE_MAX = 200;
+
+export function parseNewTask(body: unknown): NewTask | { error: string } {
+  const input = (typeof body === "object" && body !== null ? body : {}) as Record<string, unknown>;
+  const title = typeof input.title === "string" ? input.title.trim() : "";
+  if (!title) return { error: "title is required" };
+  if (title.length > TITLE_MAX) return { error: `title must be at most ${TITLE_MAX} characters` };
+  const raw = input.description;
+  if (raw !== undefined && raw !== null && typeof raw !== "string") {
+    return { error: "description must be a string" };
+  }
+  const description = typeof raw === "string" && raw.trim() ? raw.trim() : null;
+  return { title, description };
+}
diff --git a/tests/unit/server/create-task.test.ts b/tests/unit/server/create-task.test.ts
new file mode 100644
index 0000000..bcb8918
--- /dev/null
+++ b/tests/unit/server/create-task.test.ts
@@ -0,0 +1,27 @@
+import request from "supertest";
+import { describe, expect, it } from "vitest";
+import { createApp } from "../../../src/server/app.ts";
+import { openDb } from "../../../src/server/db.ts";
+
+describe("POST /api/tasks", () => {
+  it("creates a task", async () => {
+    const app = createApp(openDb(":memory:"));
+    const res = await request(app).post("/api/tasks").send({ title: " Write tests ", description: "" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ title: "Write tests", description: null });
+    expect(res.headers.location).toBe(`/api/tasks/${res.body.id}`);
+    const list = await request(app).get("/api/tasks");
+    expect(list.body).toEqual([res.body]);
+  });
+
+  it("validates the title and description", async () => {
+    const app = createApp(openDb(":memory:"));
+    expect((await request(app).post("/api/tasks").send({})).body).toEqual({ error: "title is required" });
+    expect((await request(app).post("/api/tasks").send({ title: "x".repeat(201) })).body).toEqual({
+      error: "title must be at most 200 characters",
+    });
+    expect((await request(app).post("/api/tasks").send({ title: "x", description: [] })).body).toEqual({
+      error: "description must be a string",
+    });
+  });
+});
