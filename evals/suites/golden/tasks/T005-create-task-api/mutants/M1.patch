+
+export interface NewTask {
+  title: string;
+  description: string | null;
+}
+
+export function createTask(db: Db, task: NewTask): Task {
+  const row = db
+    .prepare("INSERT INTO tasks (title, description) VALUES (?, ?) RETURNING id, title, description, created_at")
+    .get(task.title, task.description) as unknown as TaskRow;
+  return toTask(row);
+}
