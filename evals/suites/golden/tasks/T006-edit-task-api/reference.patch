diff --git a/src/server/tasks.ts b/src/server/tasks.ts
index 8999551..62edafa 100644
--- a/src/server/tasks.ts
+++ b/src/server/tasks.ts
@@ -20,3 +20,20 @@ export function listTasks(db: Db): Task[] {
     .all() as unknown as TaskRow[];
   return rows.map(toTask);
 }
+
+export interface TaskChanges {
+  title?: string;
+  description?: string | null;
+}
+
+/** Applies the changes; returns the updated task, or null if there is no such task. */
+export function updateTask(db: Db, id: number, changes: TaskChanges): Task | null {
+  const row = db.prepare("SELECT id, title, description, created_at FROM tasks WHERE id = ?").get(id) as
+    | TaskRow
+    | undefined;
+  if (!row) return null;
+  const title = changes.title ?? row.title;
+  const description = changes.description === undefined ? row.description : changes.description;
+  db.prepare("UPDATE tasks SET title = ?, description = ? WHERE id = ?").run(title, description, id);
+  return toTask({ ...row, title, description });
+}
diff --git a/src/server/validation.ts b/src/server/validation.ts
new file mode 100644
index 0000000..8600d7c
--- /dev/null
+++ b/src/server/validation.ts
@@ -0,0 +1,29 @@
+/** Request body and URL checks. Each returns the clean value, or an error for a 400. */
+import type { TaskChanges } from "./tasks.ts";
+
+export const TITLE_MAX = 200;
+
+type Result<T> = T | { error: string };
+
+/** A task id from the URL: a positive whole number, or null. */
+export function parseTaskId(raw: string): number | null {
+  return /^[1-9]\d*$/.test(raw) ? Number(raw) : null;
+}
+
+export function parseTaskChanges(body: unknown): Result<TaskChanges> {
+  const input = (typeof body === "object" && body !== null ? body : {}) as Record<string, unknown>;
+  if (!("title" in input) && !("description" in input)) return { error: "nothing to update" };
+  const changes: TaskChanges = {};
+  if ("title" in input) {
+    const title = typeof input.title === "string" ? input.title.trim() : "";
+    if (!title) return { error: "title is required" };
+    if (title.length > TITLE_MAX) return { error: `title must be at most ${TITLE_MAX} characters` };
+    changes.title = title;
+  }
+  if ("description" in input) {
+    const raw = input.description;
+    if (raw !== null && typeof raw !== "string") return { error: "description must be a string" };
+    changes.description = typeof raw === "string" && raw.trim() ? raw.trim() : null;
+  }
+  return changes;
+}
diff --git a/tests/unit/server/edit-task.test.ts b/tests/unit/server/edit-task.test.ts
new file mode 100644
