--- /dev/null
+++ b/tests/unit/server/edit-task.test.ts
@@ -0,0 +1,20 @@
+import request from "supertest";
+import { describe, expect, it } from "vitest";
+import { createApp } from "../../../src/server/app.ts";
+import { openDb, seed } from "../../../src/server/db.ts";
+
+describe("PATCH /api/tasks/:id", () => {
+  it("updates the title", async () => {
+    const db = openDb(":memory:");
+    seed(db);
+    const res = await request(createApp(db)).patch("/api/tasks/2").send({ title: "Set up CI today" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ id: 2, title: "Set up CI today", description: null });
+  });
+
+  it("rejects an empty update and unknown tasks", async () => {
+    const app = createApp(openDb(":memory:"));
+    expect((await request(app).patch("/api/tasks/1").send({})).body).toEqual({ error: "nothing to update" });
+    expect((await request(app).patch("/api/tasks/1").send({ title: "x" })).status).toBe(404);
+  });
+});
